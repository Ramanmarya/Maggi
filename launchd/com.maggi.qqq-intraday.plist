<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.maggi.qqq-intraday</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/raman/Documents/Maggi/.venv/bin/python</string><string>-m</string><string>qqq.orchestrator</string>
    <string>--mode</string><string>intraday</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/raman/Documents/Maggi</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>

  <!-- StartCalendarInterval at :00/:15/:30/:45, NOT StartInterval.
       StartInterval was silently pended on this machine ("pended nondemand
       spawn = interval") and fired zero times in 80 minutes, with or without
       RunAtLoad. StartCalendarInterval is the mechanism that demonstrably
       works here. Same 15-minute cadence, on wall-clock boundaries. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>15</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
    <dict><key>Minute</key><integer>45</integer></dict>
  </array>

  <!-- The run exits in about a second when the market is closed, far under
       launchd's 10s minimum runtime, which otherwise looks like crash-looping
       and triggers backoff. -->
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ExitTimeOut</key><integer>120</integer>
  <key>StandardOutPath</key><string>/Users/raman/Documents/Maggi/logs/qqq_intraday_launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/raman/Documents/Maggi/logs/qqq_intraday_launchd.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
